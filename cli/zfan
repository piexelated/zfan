class FanHardware:
    """Reads and changes fan state through the driver's sysfs files."""

    def __init__(self):
        self.hwmon = self._find_hwmon()
        self.device = self.hwmon / "device"
        self.coretemp_input = self._find_package_temperature()
        self.readings = SystemReadings()

    @staticmethod
    def _find_hwmon():
        for name_file in Path("/sys/class/hwmon").glob("hwmon*/name"):
            if name_file.read_text().strip() == HWMON_NAME:
                return name_file.parent
        raise FanError("driver not loaded", "load it with: sudo modprobe hp_zbook_fury_fan")

    @staticmethod
    def _find_package_temperature():
        for name_file in Path("/sys/class/hwmon").glob("hwmon*/name"):
            if name_file.read_text().strip() != "coretemp":
                continue
            for label in name_file.parent.glob("temp*_label"):
                if label.read_text().startswith("Package"):
                    return label.with_name(label.name.replace("label", "input"))
        return None

    def _read_fans(self, kind):
        return [int((self.hwmon / f"fan{i}_{kind}").read_text()) for i in range(1, FAN_COUNT + 1)]

    def fan_rpms(self):
        return self._read_fans("input")

    def fan_targets(self):
        return self._read_fans("target")

    def fan_mode(self):
        return (self.device / "fan_mode").read_text().strip()

    def afan(self):
        """Raw EC fan-mode byte, or "" with a driver older than 0.4.2."""
        return read_text(self.device / "afan")

    def cpu_celsius(self):
        """Package die sensor from coretemp: the real, spiky temperature the CPU throttles on."""
        return celsius_from(self.coretemp_input) if self.coretemp_input else None

    @staticmethod
    def power_profile():
        return PLATFORM_PROFILE.read_text().strip() if PLATFORM_PROFILE.exists() else "unknown"

    @staticmethod
    def _write(path, value, what):
        try:
            path.write_text(value)
        except PermissionError:
            raise FanError(f"no permission to change the {what}",
                           "run sudo ./install.sh to install the udev rule, or use sudo")
        except OSError as error:
            raise FanError(f"the driver rejected the {what} ({error.strerror})")

    def set_fan_mode(self, mode):
        self._write(self.device / "fan_mode", mode, "fan mode")
        self._save_fan_mode(mode)

    @staticmethod
    def _save_fan_mode(mode):
        """Best effort: without install.sh's file the mode lasts until the driver reloads; doctor reports that."""
        try:
            SAVED_FAN_MODE.write_text(mode + "\n")
        except OSError:
            pass


