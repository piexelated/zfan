class RateMeter:
    """Turns a growing counter into a per-second rate between two consecutive readings."""

    def __init__(self, wrap=None):
        self.wrap = wrap
        self.last = None

    def update(self, value):
        now = time.monotonic()
        previous, self.last = self.last, (value, now)
        if value is None or previous is None or previous[0] is None or now <= previous[1]:
            return None
        delta = value - previous[0]
        if delta < 0 and self.wrap:
            delta += self.wrap
        return delta / (now - previous[1]) if delta >= 0 else None


class RaplConstraint:
    def __init__(self, watts, window_s, rated_w):
        self.watts, self.window_s, self.rated_w = watts, window_s, rated_w


class RaplZone:
    """One powercap zone, e.g. intel-rapl:0 (MSR) or intel-rapl-mmio:0 (MMIO), with its limits by PL name."""

    def __init__(self, zone_id, name, enabled, constraints):
        self.zone_id, self.name, self.enabled, self.constraints = zone_id, name, enabled, constraints

    @property
    def interface(self):
        return "msr" if self.zone_id.startswith(RAPL_MSR_PREFIX) else "mmio"

    @property
    def is_package(self):
        return self.name == CPU_PACKAGE_ZONE


def applied_limit_w(zones, pl):
    """The lowest enabled package limit of this kind: that one is what the CPU obeys."""
    values = [zone.constraints[pl].watts for zone in zones
              if zone.is_package and zone.enabled and pl in zone.constraints and zone.constraints[pl].watts]
    return min(values) if values else None


class CpuReading:
    def __init__(self, celsius, hp_celsius, package_w, throttle_percent, zones, avg_ghz, max_ghz, governor, epp,
                 turbo):
        self.celsius, self.hp_celsius = celsius, hp_celsius
        self.package_w, self.throttle_percent = package_w, throttle_percent
        self.zones = zones
        self.avg_ghz, self.max_ghz = avg_ghz, max_ghz
        self.governor, self.epp, self.turbo = governor, epp, turbo


class GpuReading:
    def __init__(self, fields):
        (celsius, draw, enforced, default, maximum, self.pstate, core, memory, util, reasons) = fields
        self.celsius, self.draw_w = round(float(celsius)), round(float(draw))
        self.limit_w, self.default_w, self.max_w = (round(float(v)) for v in (enforced, default, maximum))
        self.core_mhz, self.memory_mhz, self.util_percent = int(core), int(memory), int(util)
        mask = int(reasons, 16)
        self.limited_by = [name for bit, name in GPU_LIMIT_REASONS.items() if mask & bit]


class SupplyReading:
    def __init__(self, on_ac, status, percent, energy_wh, full_wh, design_wh, cycles, draw_w):
        self.on_ac, self.status, self.percent = on_ac, status, percent
        self.energy_wh, self.full_wh, self.design_wh = energy_wh, full_wh, design_wh
        self.cycles, self.draw_w = cycles, draw_w


class SystemReadings:
    """CPU, GPU, EC thermal zones and power supply. Everything here is readable without root,
    except CPU package energy (readable by the admin group through the udev rule)."""

    def __init__(self):
        self.package_zone = self._find_package_zone()
        self.gpu_device = self._find_nvidia_gpu()
        wrap = read_text(self.package_zone / "max_energy_range_uj") if self.package_zone else ""
        self.package_energy = RateMeter(wrap=int(wrap) if wrap else None)
        self.throttle_time = RateMeter()
        self.hp_zone_paths = self._find_hp_zones()

    @staticmethod
    def _find_hp_zones():
        """Label → thermal zone directory, for the HP zones this firmware exposes."""
        labels = {path: label for label, path in HP_ZONES.items()}
        found = {}
        for path_file in THERMAL_ZONES.glob("thermal_zone*/device/path"):
            label = labels.get(read_text(path_file))
            if label:
                found[label] = path_file.parent.parent
        return {label: found[label] for label in HP_ZONES if label in found}

    def hp_zones(self):
        """HP's temperatures in °C by label; None where a zone read fails."""
        return {label: celsius_from(zone / "temp") for label, zone in self.hp_zone_paths.items()}

    @staticmethod
    def _find_package_zone():
        for zone in POWERCAP.glob(RAPL_MSR_PREFIX + "*"):
            if read_text(zone / "name") == CPU_PACKAGE_ZONE:
                return zone
        return None

    @staticmethod
    def _find_nvidia_gpu():
        for device in PCI_DEVICES.glob("*"):
            if (read_text(device / "vendor") == NVIDIA_VENDOR
                    and read_text(device / "class").startswith(DISPLAY_CLASS_PREFIX)):
                return device
        return None

    @staticmethod
    def _int(path):
        value = read_text(path)
        return int(value) if value.lstrip("-").isdigit() else None

    def cpu(self, celsius, hp_celsius):
        energy_uj = self._int(self.package_zone / "energy_uj") if self.package_zone else None
        package_uj_per_s = self.package_energy.update(energy_uj)
        throttle_ms_per_s = self.throttle_time.update(self._int(PACKAGE_THROTTLE_MS))
        frequencies = [self._int(path) for path in CPU_ROOT.glob("cpu[0-9]*/cpufreq/scaling_cur_freq")]
        frequencies = [khz for khz in frequencies if khz]
        cpufreq = CPU_ROOT / "cpu0" / "cpufreq"
        return CpuReading(
            celsius=celsius,
            hp_celsius=hp_celsius,
            package_w=package_uj_per_s / MICRO if package_uj_per_s is not None else None,
            throttle_percent=min(100.0, throttle_ms_per_s / MS_PER_S * 100) if throttle_ms_per_s is not None else None,
            zones=self.rapl_zones(),
            avg_ghz=sum(frequencies) / len(frequencies) / MICRO if frequencies else None,
            max_ghz=max(frequencies) / MICRO if frequencies else None,
            governor=read_text(cpufreq / "scaling_governor"),
            epp=read_text(cpufreq / "energy_performance_preference"),
            turbo=read_text(CPU_ROOT / "intel_pstate" / "no_turbo") == "0",
        )

    @classmethod
    def rapl_zones(cls):
        zones = []
        for zone in sorted(POWERCAP.glob("intel-rapl*:*")):
            constraints = {}
            for name_file in zone.glob("constraint_*_name"):
                pl = RAPL_LIMITS.get(read_text(name_file))
                prefix = name_file.name.removesuffix("name")
                microwatts = cls._int(zone / (prefix + "power_limit_uw"))
                if pl is None or microwatts is None:
                    continue
                window_us = cls._int(zone / (prefix + "time_window_us"))
                rated_uw = cls._int(zone / (prefix + "max_power_uw"))
                constraints[pl] = RaplConstraint(microwatts // MICRO, window_us / MICRO if window_us else None,
                                                 rated_uw // MICRO if rated_uw else None)
            zones.append(RaplZone(zone.name, read_text(zone / "name"), read_text(zone / "enabled") == "1",
                                  constraints))
        return zones

    def gpu_state(self):
        return read_text(self.gpu_device / "power" / "runtime_status") if self.gpu_device else None

    def gpu(self):
        """None while the dGPU sleeps: querying it would wake it up."""
        if self.gpu_state() != "active":
            return None
        output = run(["nvidia-smi", "--query-gpu=" + ",".join(GPU_QUERY_FIELDS), "--format=csv,noheader,nounits"],
                     timeout=GPU_QUERY_TIMEOUT_S)
        try:
            return GpuReading([field.strip() for field in output.split(",")])
        except ValueError:
            return None

    @staticmethod
    def ec_zones():
        """EC sensors SEN1..SEN6 in °C; the hottest one picks the EC's fan-curve step."""
        zones = []
        for zone in THERMAL_ZONES.glob("thermal_zone*"):
            name = read_text(zone / "type")
            millidegrees = read_text(zone / "temp")
            if name.startswith(EC_ZONE_PREFIX) and millidegrees:
                zones.append((name.lower(), round(int(millidegrees) / 1000)))
        return sorted(zones)

    def supply(self):
        on_ac, battery = False, None
        for supply in POWER_SUPPLIES.glob("*"):
            kind = read_text(supply / "type")
            if kind == "Mains":
                on_ac = on_ac or read_text(supply / "online") == "1"
            elif kind == "Battery" and read_text(supply / "scope") != "Device":
                battery = supply
        if battery is None:
            return SupplyReading(on_ac, None, None, None, None, None, None, None)

        def wh(name):
            value = self._int(battery / name)
            return value / MICRO if value is not None else None

        draw = self._int(battery / "power_now")
        return SupplyReading(on_ac, read_text(battery / "status").lower(), self._int(battery / "capacity"),
                             wh("energy_now"), wh("energy_full"), wh("energy_full_design"),
                             self._int(battery / "cycle_count"), draw / MICRO if draw else None)


class Snapshot:
    """One reading of everything the panel shows."""

    def __init__(self, hardware):
        self.rpms = hardware.fan_rpms()
        self.targets = hardware.fan_targets()
        self.power = hardware.power_profile()
        self.fan_mode = hardware.fan_mode()
        self.afan = hardware.afan()
        self.tuned = read_text(TUNED_ACTIVE_PROFILE)
        self.fan_ceiling = read_text(FAN_CEILING_SETTING / "current_value")
        self.fan_ceiling_max = read_text(FAN_CEILING_SETTING / "possible_values").rpartition(";")[2]
        readings = hardware.readings
        self.hp_zones = readings.hp_zones()
        self.cpu = readings.cpu(hardware.cpu_celsius(), self.hp_zones.get("cpu"))
        self.gpu_state = readings.gpu_state()
        self.gpu = readings.gpu()
        self.ec_zones = readings.ec_zones()
        self.supply = readings.supply()

    def effective_fan_mode(self):
        return FOLLOWED_FAN_MODE.get(self.power) if self.fan_mode == FOLLOW else self.fan_mode


# ─── panel ──────────────────────────────────────────────────────────────────

def pad(text, width):
    return text + " " * max(0, width - visible_len(text))


def note(text):
    return paint(text, MUTED)


def format_window(seconds):
    if seconds is None:
        return ""
    return f"{seconds:.0f} s" if seconds >= 1 else f"{seconds * MS_PER_S:.1f} ms"


def degrees(celsius, width=0):
    if celsius is None:
        return pad(note("—"), width)
    color = HOT if celsius >= HOT_C else ACCENT if celsius >= WARM_C else TEXT
    return pad(paint(f"{celsius}°", color), width)


