SLIDER_WIDTH = 40
SLIDER_ENDS = ("Quieter", "Cooler")
SLIDER_INDENT = MARGIN + " " * LABEL_WIDTH
# Solid while the fan level is pinned, hollow while it follows the desktop power profile.
PINNED_MARKER, FOLLOWING_MARKER = "▲", "△"
CONTROL_SELECTED, CONTROL_UNSELECTED = "●", "○"
STATUS_GAP = "    "
# The desktop's name for each platform profile, where it differs.
POWER_MODE_NAMES = {"quiet": "power saver"}
READING_COLUMNS = (("temp", 7), ("hp", 7), ("power", 9), ("limit", 11), ("clock", 11))
FAN_READING_WIDTH = len("  00000 rpm")


def label_starts(labels, width):
    """Spread the labels edge to edge: first flush left, last flush right."""
    last = len(labels) - 1
    return [round(index * (width - len(label)) / last) for index, label in enumerate(labels)]


def slider_track(level, following, color):
    """A plain line with one marker under the middle of the selected level's label."""
    if level not in FAN_LEVELS:
        return paint("─" * SLIDER_WIDTH, MUTED)
    index = FAN_LEVELS.index(level)
    position = label_starts(FAN_LEVELS, SLIDER_WIDTH)[index] + len(level) // 2
    marker = paint(FOLLOWING_MARKER if following else PINNED_MARKER, color, bold=not following)
    return paint("─" * position, MUTED) + marker + paint("─" * (SLIDER_WIDTH - position - 1), MUTED)


def slider_labels(level, following, color):
    line = ""
    for label, start in zip(FAN_LEVELS, label_starts(FAN_LEVELS, SLIDER_WIDTH)):
        shown = paint(label, color, bold=not following) if label == level else note(label)
        line = pad(line, start) + shown
    return line


def power_mode_name(profile):
    return POWER_MODE_NAMES.get(profile, profile)


def control_choice(name, selected):
    if selected:
        return paint(CONTROL_SELECTED + " ", ACCENT) + paint(name, TEXT, bold=True)
    return note(f"{CONTROL_UNSELECTED} {name}")


def control_outcome(snapshot, following):
    """Following: which fan level the power mode gives. Manual: that the power mode is ignored."""
    mode = power_mode_name(snapshot.power)
    if not following:
        return note(f"{mode} ignored")
    level = snapshot.effective_fan_mode()
    if level is None:
        return note(f"{mode}: no fan level for it")
    return paint(mode, LEVEL_COLOR.get(snapshot.power, TEXT)) + note(" → ") + paint(level, LEVEL_COLOR[level])


def fan_control(snapshot):
    """Who sets the fan level: the desktop power mode, or a level pinned by hand."""
    following = snapshot.fan_mode == FOLLOW
    choices = control_choice("power mode", following) + "    " + control_choice("manual", not following)
    return row("control", pad(choices, SLIDER_WIDTH) + STATUS_GAP + control_outcome(snapshot, following))


def fan_slider(snapshot):
    level = snapshot.effective_fan_mode()
    following = snapshot.fan_mode == FOLLOW
    color = LEVEL_COLOR.get(level, TEXT)
    track = slider_track(level, following, color)
    return [
        fan_control(snapshot),
        "",
        SLIDER_INDENT + spread(note(SLIDER_ENDS[0]), note(SLIDER_ENDS[1]), SLIDER_WIDTH),
        row("fans", track),
        SLIDER_INDENT + slider_labels(level, following, color),
    ]


def reading_row(label, cells, status=""):
    content = "".join(pad(cell, width) for cell, (_, width) in zip(cells, READING_COLUMNS))
    return row(label, content + status)


def throttle_warning(percent):
    if percent is None or percent < 1:
        return ""
    return paint(f"throttling {percent:.0f}%", HOT if percent >= THROTTLE_ALERT_PERCENT else CAUTION)


def hp_degrees(celsius):
    return note(f"{celsius}°" if celsius is not None else "—")


def reading_rows(snapshot):
    header = SLIDER_INDENT + "".join(paint(name.ljust(width), FAINT) for name, width in READING_COLUMNS)
    cpu = snapshot.cpu
    pl1 = applied_limit_w(cpu.zones, "pl1")
    hp_gpu = hp_degrees(snapshot.hp_zones.get("gpu"))
    rows = [header, reading_row("cpu", [
        degrees(cpu.celsius),
        hp_degrees(cpu.hp_celsius),
        paint(f"{cpu.package_w:.0f} W", TEXT) if cpu.package_w is not None else note("—"),
        paint(f"{pl1} W", TEXT) if pl1 else note("—"),
        paint(f"{cpu.avg_ghz:.1f} GHz", TEXT) if cpu.avg_ghz else note("—"),
    ], throttle_warning(cpu.throttle_percent))]
    gpu = snapshot.gpu
    if gpu is None:
        rows.append(reading_row("gpu", [note("asleep"), hp_gpu]))
        return rows
    limited = paint("limited by " + ", ".join(gpu.limited_by), CAUTION) if gpu.limited_by else ""
    rows.append(reading_row("gpu", [degrees(gpu.celsius), hp_gpu, paint(f"{gpu.draw_w} W", TEXT),
                                    paint(f"{gpu.limit_w} W", TEXT), paint(gpu.pstate, TEXT)], limited))
    return rows


def gauge_span(start, end, filled, color):
    lit = max(0, min(end, filled) - start)
    return paint("━" * lit, color) + paint("─" * (end - start - lit), FAINT)


def fan_gauge(rpm, target, scale, width):
    """One bar whose color follows the RPM level, with a tick at the target while the fan is still ramping."""
    filled = round(min(rpm / scale, 1.0) * width)
    color = level_gradient(min(rpm / scale, 1.0))
    if abs(target - rpm) <= RAMP_THRESHOLD_RPM:
        return gauge_span(0, width, filled, color)
    tick = min(round(min(target / scale, 1.0) * width), width - 1)
    return gauge_span(0, tick, filled, color) + paint("│", TEXT) + gauge_span(tick + 1, width, filled, color)


def fan_rows(snapshot, width):
    gauge_width = width - len(SLIDER_INDENT) - FAN_READING_WIDTH
    return [row(f"fan {index + 1}", fan_gauge(rpm, target, FAN_SCALE_RPM[index], gauge_width)
                + paint(f"  {rpm:>5}", TEXT) + note(" rpm"))
            for index, (rpm, target) in enumerate(zip(snapshot.rpms, snapshot.targets))]


def supply_summary(supply):
    if supply.on_ac:
        text = "ac"
    else:
        text = "battery" + (f" {supply.draw_w:.0f} W" if supply.draw_w else "")
    if supply.percent is not None:
        text += f"  {supply.percent}%"
    return note(text)


def render_main(snapshot, width):
    return fan_slider(snapshot) + [""] + reading_rows(snapshot) + [""] + fan_rows(snapshot, width)


