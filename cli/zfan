PL_KINDS = (("pl1", "long term"), ("pl2", "short term"), ("pl4", "peak"))
RAPL_LABEL_WIDTH = 26
RAPL_CELL_WIDTH = 26
DETAIL_LABEL_WIDTH = 13
DETAIL_VALUE_WIDTH = 9
DETAIL_BLOCK_WIDTH = 40


def rapl_cell(constraint):
    if constraint is None:
        return note(f"{'—':>4}")
    window = format_window(constraint.window_s)
    return paint(f"{constraint.watts:>4} W", TEXT) + (note(f"  {window}") if window else "")


def rapl_rows(zones):
    """Every RAPL limit, one column per package interface (MSR and MMIO), named by its sysfs zone."""
    packages = sorted((zone for zone in zones if zone.is_package), key=lambda zone: zone.interface != "msr")
    title = pad(MARGIN + paint("cpu power limits", TEXT, bold=True), len(MARGIN) + RAPL_LABEL_WIDTH)
    header = title + "".join(pad(note(f"{zone.interface}  ") + paint(zone.zone_id, FAINT), RAPL_CELL_WIDTH)
                             for zone in packages) + note("applies")
    rows = [header]
    for pl, meaning in PL_KINDS:
        cells = "".join(pad(rapl_cell(zone.constraints.get(pl)), RAPL_CELL_WIDTH) for zone in packages)
        applied = applied_limit_w(zones, pl)
        rows.append(MARGIN + pad(paint(pl, TEXT) + note(f"  {meaning}"), RAPL_LABEL_WIDTH) + cells
                    + (paint(f"{applied} W", ACCENT, bold=True) if applied else ""))
    rated = "".join(pad(paint(f"{zone.constraints['pl1'].rated_w:>4} W", TEXT)
                        if "pl1" in zone.constraints and zone.constraints["pl1"].rated_w else note("—"),
                        RAPL_CELL_WIDTH) for zone in packages)
    rows.append(MARGIN + pad(note("rated  max_power"), RAPL_LABEL_WIDTH) + rated)
    for zone in zones:
        if zone.is_package:
            continue
        limits = "   ".join(f"{pl} {constraint.watts} W  {format_window(constraint.window_s)}".rstrip()
                            for pl, constraint in sorted(zone.constraints.items()))
        state = note(limits) if zone.enabled else paint("disabled", FAINT)
        rows.append(MARGIN + pad(paint(zone.name, TEXT) + paint(f"  {zone.zone_id}", FAINT), RAPL_LABEL_WIDTH)
                    + state)
    return rows


def detail(label, value, unit="", highlight=False):
    """(label, value, unit): numbers right-aligned so they line up, text left-aligned."""
    numeric = value[:1].isdigit() or value[:1] in "-—"
    shown = value.rjust(DETAIL_VALUE_WIDTH) if numeric else value
    label = paint(label.ljust(DETAIL_LABEL_WIDTH), ACCENT, bold=True) if highlight else note(label.ljust(DETAIL_LABEL_WIDTH))
    return label + paint(shown, TEXT) + (note(" " + unit) if unit else "")


def cpu_block(cpu):
    items = [
        ("temp", str(cpu.celsius) if cpu.celsius is not None else "—", "°C"),
        ("package", f"{cpu.package_w:.0f}" if cpu.package_w is not None else "—", "W"),
        ("throttling", f"{cpu.throttle_percent:.0f}" if cpu.throttle_percent is not None else "—", "%"),
        ("clock avg", f"{cpu.avg_ghz:.2f}" if cpu.avg_ghz else "—", "GHz"),
        ("clock peak", f"{cpu.max_ghz:.2f}" if cpu.max_ghz else "—", "GHz"),
        ("governor", cpu.governor or "—", ""),
        ("epp", cpu.epp or "—", ""),
        ("turbo", "on" if cpu.turbo else "off", ""),
    ]
    return "cpu", [detail(*item) for item in items]


def gpu_block(state, gpu):
    if gpu is None:
        return "gpu", [detail("state", f"asleep ({state or 'none'})")]
    items = [
        ("limit", str(gpu.limit_w), "W"),
        ("default", str(gpu.default_w), "W"),
        ("max", str(gpu.max_w), "W"),
        ("core", str(gpu.core_mhz), "MHz"),
        ("memory", str(gpu.memory_mhz), "MHz"),
        ("util", str(gpu.util_percent), "%"),
        ("pstate", gpu.pstate, ""),
        ("limited by", ", ".join(gpu.limited_by) or "nothing", ""),
    ]
    return "gpu", [detail(*item) for item in items]


def fan_ceiling_detail(value, maximum):
    if not value:
        return detail("fan ceiling", "—")
    if value == "0":
        return detail("fan ceiling", "bios default")
    return detail("fan ceiling", value, f"/ {maximum}" if maximum else "")


def ec_block(snapshot):
    hottest = max((celsius for _, celsius in snapshot.ec_zones), default=None)
    lines = []
    for name, celsius in snapshot.ec_zones:
        # The hottest sensor sets the fan-curve step.
        lines.append(detail(name, str(celsius), "°C", highlight=celsius == hottest))
    lines.append(detail("afan", snapshot.afan or "—"))
    lines.append(detail("tuned", snapshot.tuned or "—"))
    lines.append(fan_ceiling_detail(snapshot.fan_ceiling, snapshot.fan_ceiling_max))
    return "ec", lines


def hp_block(hp_zones):
    lines = [detail(label, str(celsius) if celsius is not None else "—", "°C") for label, celsius in hp_zones.items()]
    return "hp", lines or [detail("zones", "none found")]


def supply_block(supply):
    items = [("source", "ac" if supply.on_ac else "battery", "")]
    if supply.percent is not None:
        items += [("battery", str(supply.percent), "%"), ("status", supply.status or "—", "")]
        if supply.draw_w:
            items.append(("draw", f"{supply.draw_w:.0f}", "W"))
        if supply.full_wh:
            items.append(("energy", f"{supply.energy_wh:.1f}", f"/ {supply.full_wh:.1f} Wh"))
        if supply.design_wh and supply.full_wh:
            items.append(("health", f"{supply.full_wh / supply.design_wh * 100:.0f}", "%"))
        if supply.cycles is not None:
            items.append(("cycles", str(supply.cycles), ""))
    return "supply", [detail(*item) for item in items]


def side_by_side(left, right):
    """Two (title, lines) blocks next to each other."""
    (left_title, left_lines), (right_title, right_lines) = left, right
    rows = [MARGIN + pad(paint(left_title, TEXT, bold=True), DETAIL_BLOCK_WIDTH) + paint(right_title, TEXT, bold=True)]
    for index in range(max(len(left_lines), len(right_lines))):
        left_line = left_lines[index] if index < len(left_lines) else ""
        right_line = right_lines[index] if index < len(right_lines) else ""
        rows.append(MARGIN + pad(left_line, DETAIL_BLOCK_WIDTH) + right_line)
    return rows


def render_details(snapshot):
    return (rapl_rows(snapshot.cpu.zones) + [""]
            + side_by_side(cpu_block(snapshot.cpu), gpu_block(snapshot.gpu_state, snapshot.gpu)) + [""]
            + side_by_side(hp_block(snapshot.hp_zones), ec_block(snapshot)) + [""]
            + side_by_side(supply_block(snapshot.supply), ("", [])))


class View(enum.Enum):
    MAIN = enum.auto()
    DETAILS = enum.auto()


def render_panel(snapshot, width, view=View.MAIN):
    header = spread(MARGIN + paint("zfan", TEXT, bold=True) + " " + note(VERSION), note(DEVICE_NAME), width)
    body = render_main(snapshot, width) if view is View.MAIN else render_details(snapshot)
    return [header, ""] + body


# ─── interactive dashboard ──────────────────────────────────────────────────

class Toast:
    def __init__(self, text="", color=MUTED):
        self.text, self.color = text, color
        self.expires = time.monotonic() + TOAST_DURATION_S

    def visible(self):
        return bool(self.text) and time.monotonic() < self.expires


class Dashboard:
    """f switches between the desktop power mode and manual; in manual, ←→ pick a quieter or cooler fan level."""

    KEYS_LEFT = {"\x1b[D", "h"}
    KEYS_RIGHT = {"\x1b[C", "l"}
    KEYS_CONTROL = {"f"}
    KEYS_QUIT = {"q", "Q", "\x1b"}
    KEYS_DETAILS = {"i", "\t"}

    def __init__(self, hardware):
        self.hardware = hardware
        self.running = True
        self.view = View.MAIN
        self.toast = Toast()
        self.refresh()

    def refresh(self):
        self.snapshot = Snapshot(self.hardware)

    def notify(self, text, color):
        self.toast = Toast(text, color)

    def step_fan_level(self, step):
        """The slider only moves in manual; f is the one way to change who controls the fans."""
        if self.snapshot.fan_mode == FOLLOW:
            self.notify("the power mode sets the fans · f for manual", MUTED)
            return
        level = self.snapshot.effective_fan_mode()
        index = FAN_LEVELS.index(level) if level in FAN_LEVELS else FAN_LEVELS.index("auto")
        target = FAN_LEVELS[max(0, min(index + step, len(FAN_LEVELS) - 1))]
        if target == self.snapshot.fan_mode:
            return
        self._set_fan_mode(target, f"✓ fans {target}")

    def toggle_control(self):
        """Hands the fans to the power mode, or pins the level the power mode gave them."""
        if self.snapshot.fan_mode != FOLLOW:
            self._set_fan_mode(FOLLOW, "✓ fans set by power mode")
            return
        level = self.snapshot.effective_fan_mode()
        if level not in FAN_LEVELS:
            return
        self._set_fan_mode(level, f"✓ fans manual: {level}")

    def _set_fan_mode(self, mode, success):
        try:
            self.hardware.set_fan_mode(mode)
        except FanError as error:
            self.notify(f"✗ {error.message}", HOT)
            return
        self.refresh()
        self.notify(success, ACCENT)

    def handle_key(self, key):
        if key in self.KEYS_QUIT:
            self.running = False
        elif key in self.KEYS_DETAILS:
            self.view = View.DETAILS if self.view is View.MAIN else View.MAIN
        elif self.view is View.DETAILS:
            return
        elif key in self.KEYS_LEFT:
            self.step_fan_level(-1)
        elif key in self.KEYS_RIGHT:
            self.step_fan_level(1)
        elif key in self.KEYS_CONTROL:
            self.toggle_control()

    def render(self, columns, rows):
        if columns < MIN_WIDTH:
            return "\n" + MARGIN + paint(f"widen the terminal to {MIN_WIDTH} columns", MUTED)
        width = min(columns, MAX_WIDTH)
        panel = render_panel(self.snapshot, width, self.view)
        lines = [""] + panel + ["", self._footer(width)]
        if len(lines) + 1 > rows:
            return "\n" + MARGIN + paint(f"make the terminal at least {len(lines) + 1} rows tall", MUTED)
        return "\n".join(lines)

    def _footer(self, width):
        def hint(key, label):
            return paint(key, TEXT, bold=True) + " " + paint(label, MUTED)

        if self.view is View.DETAILS:
            keys = [hint("i", "back"), hint("q", "quit")]
        else:
            if self.snapshot.fan_mode == FOLLOW:
                keys = [hint("f", "manual")]
            else:
                keys = [hint("←→", "fans"), hint("f", "power mode")]
            keys += [hint("i", "details"), hint("q", "quit")]
        footer = spread(MARGIN + supply_summary(self.snapshot.supply), "  ".join(keys), width)
        message = paint(self.toast.text, self.toast.color) if self.toast.visible() else ""
        return footer + "\n" + MARGIN + message


class Terminal:
    """Alternate screen with raw keys; always restores the terminal."""

    def __enter__(self):
        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        sys.stdout.write("\x1b[?1049h\x1b[?25l")
        return self

    def __exit__(self, *exc):
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()

    def read_keys(self, timeout):
        """Keys typed since the last call; arrow-key escape sequences stay whole."""
        ready, _, _ = select.select([self.fd], [], [], timeout)
        if not ready:
            return []
        data = os.read(self.fd, 64).decode(errors="ignore")
        keys = []
        while data:
            length = 3 if data.startswith("\x1b[") else 1
            keys.append(data[:length])
            data = data[length:]
        return keys

    @staticmethod
    def draw(text):
        sys.stdout.write("\x1b[H" + text.replace("\n", "\x1b[K\n") + "\x1b[K\x1b[J")
        sys.stdout.flush()


def run_dashboard(hardware):
    dashboard = Dashboard(hardware)
    next_refresh = time.monotonic() + SENSOR_REFRESH_S
    with Terminal() as terminal:
        while dashboard.running:
            size = shutil.get_terminal_size((80, 24))
            terminal.draw(dashboard.render(size.columns, size.lines))
            for key in terminal.read_keys(FRAME_INTERVAL_S):
                dashboard.handle_key(key)
            if time.monotonic() >= next_refresh:
                dashboard.refresh()
                next_refresh = time.monotonic() + SENSOR_REFRESH_S


# ─── updates and uninstall ──────────────────────────────────────────────────

GITHUB_REPO = "piexelated/zfan"
RELEASES_PAGE = f"https://github.com/{GITHUB_REPO}/releases"
LATEST_RELEASE_URL = f"https://api.github.com/repos/{GITHUB_REPO}/releases/latest"
RELEASE_CHECK_TIMEOUT_S = 3
RELEASE_DOWNLOAD_TIMEOUT_S = 60


class Release:
    def __init__(self, version, assets):
        self.version = version
        self.assets = assets  # file name → download URL
        self.archive = f"zfan-{version}.tar.gz"
        self.checksum = self.archive + ".sha256"
        # git archive's --prefix in the release workflow.
        self.source_dir = f"zfan-{version}"


def fetch(url, timeout):
    request = urllib.request.Request(url, headers={"User-Agent": f"zfan/{VERSION}"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read()


def latest_release():
    """The newest GitHub release, or None when GitHub is unreachable or nothing is published."""
    try:
        release = json.loads(fetch(LATEST_RELEASE_URL, RELEASE_CHECK_TIMEOUT_S))
    except (OSError, ValueError):
        return None
    version = release.get("tag_name", "").removeprefix("v")
    if not version:
        return None
    return Release(version, {asset["name"]: asset["browser_download_url"] for asset in release.get("assets", [])})


def version_key(version):
    try:
        return tuple(int(part) for part in version.split("."))
    except ValueError:
        return None


def is_newer(version):
    current, candidate = version_key(VERSION), version_key(version)
    return bool(current and candidate and candidate > current)


def download_release(release, workdir):
    """Download and verify the release source, unpack it into workdir and return the source directory."""
    if release.archive not in release.assets or release.checksum not in release.assets:
        raise FanError(f"release {release.version} has no source archive", RELEASES_PAGE)
    try:
        archive = fetch(release.assets[release.archive], RELEASE_DOWNLOAD_TIMEOUT_S)
        expected = fetch(release.assets[release.checksum], RELEASE_CHECK_TIMEOUT_S).decode().split()[0]
    except (OSError, IndexError, UnicodeDecodeError):
        raise FanError("download failed", "check your connection and try again") from None
    if hashlib.sha256(archive).hexdigest() != expected:
        raise FanError("download is corrupted (checksum mismatch)", "try again, or download it from " + RELEASES_PAGE)
    archive_path = workdir / release.archive
    archive_path.write_bytes(archive)
    with tarfile.open(archive_path) as tar:
        # The "data" filter refuses absolute paths, links out of workdir and device files.
        tar.extractall(workdir, filter="data")
    return workdir / release.source_dir


def run_installer(source_dir):
    command = ["sh", "install.sh"] if os.geteuid() == 0 else ["sudo", "sh", "install.sh"]
    if subprocess.run(command, cwd=source_dir).returncode != 0:
        raise FanError("install failed", "see the messages above")


def update():
    if not hasattr(tarfile, "data_filter"):
        raise FanError("this Python is too old to unpack updates safely", "update Python (3.10.12+, 3.11.4+ or 3.12+)")
    release = latest_release()
    if release is None:
        raise FanError("couldn't find a release on GitHub", "check your connection, or see " + RELEASES_PAGE)
    if not is_newer(release.version):
        confirm(f"zfan {VERSION} is the latest")
        return
    print(MARGIN + paint(f"updating zfan {VERSION} → {release.version}", TEXT))
    with tempfile.TemporaryDirectory(prefix="zfan-update-") as workdir:
        run_installer(download_release(release, Path(workdir)))
    confirm(f"updated to {release.version}")


def confirmed(question):
    """Ask a yes/no question on stdin; anything but y or yes (including end of input) is no."""
    try:
        answer = input(MARGIN + question + " [y/N] ")
    except EOFError:
        return False
    return answer.strip().lower() in ("y", "yes")


def uninstall():
    if not INSTALLED_UNINSTALLER.is_file():
        raise FanError("the uninstaller isn't installed", "sudo ./uninstall.sh" + FROM_PROJECT)
    if not confirmed("remove the zfan driver, the zfan command and its saved fan mode?"):
        print(MARGIN + "nothing removed")
        return
    command = ["sh", str(INSTALLED_UNINSTALLER)]
    if os.geteuid() != 0:
        command.insert(0, "sudo")
    if subprocess.run(command).returncode != 0:
        raise FanError("uninstall failed", "see the messages above")


# ─── doctor ─────────────────────────────────────────────────────────────────

MODULE_NAME = "hp_zbook_fury_fan"
DKMS_PACKAGE = "hp-zbook-fury-fan"
DRIVER_NAME = "hp-zbook-fury-fan"
SUPPORTED_BOARD = "8DE2"
MODULES_LOAD_CONF = Path("/etc/modules-load.d/hp-zbook-fury-fan.conf")
UDEV_RULE = Path("/etc/udev/rules.d/70-hp-zbook-fury-fan.rules")
AFAN_RESTORE_LOG = "AFAN was"
FROM_PROJECT = "   (in the project directory)"


class Health(enum.Enum):
    OK = ("✓", ACCENT)
    INFO = ("○", MUTED)
    WARN = ("!", ACCENT)
    FAIL = ("✗", HOT)


class Finding:
    def __init__(self, label, health, detail, fix=None):
        self.label, self.health, self.detail, self.fix = label, health, detail, fix


def find_driver_hwmon():
    for name_file in Path("/sys/class/hwmon").glob("hwmon*/name"):
        if read_text(name_file) == HWMON_NAME:
            return name_file.parent
    return None


def kernel_log_this_boot():
    return run(["journalctl", "-k", "-b", "-o", "cat", "--no-pager"])


def check_hardware():
    board = read_text("/sys/class/dmi/id/board_name")
    bios = read_text("/sys/class/dmi/id/bios_version")
    if board != SUPPORTED_BOARD:
        return Finding("hardware", Health.FAIL, f"board {board or 'unknown'}",
                       f"zfan supports only the ZBook Fury G1i (board {SUPPORTED_BOARD})")
    return Finding("hardware", Health.OK, f"ZBook Fury G1i · {bios}")


def check_driver(hwmon):
    loaded = read_text(f"/sys/module/{MODULE_NAME}/version")
    installed = run(["modinfo", "-F", "version", MODULE_NAME])
    if not installed:
        return Finding("driver", Health.FAIL, "not installed for this kernel",
                       "sudo ./install.sh" + FROM_PROJECT)
    if not loaded or not hwmon:
        return Finding("driver", Health.FAIL, f"{installed} installed but not loaded",
                       f"sudo modprobe {MODULE_NAME}; then: journalctl -k -b | grep -i fury")
    if loaded != installed:
        return Finding("driver", Health.WARN, f"{loaded} loaded, {installed} installed",
                       f"sudo modprobe -r {MODULE_NAME} && sudo modprobe {MODULE_NAME}")
    if loaded != VERSION:
        return Finding("driver", Health.WARN, f"{loaded} loaded, but zfan is {VERSION}",
                       "sudo ./install.sh" + FROM_PROJECT)
    return Finding("driver", Health.OK, f"{loaded} loaded")


def check_kernel_build():
    kernel = os.uname().release
    if "installed" in run(["dkms", "status", DKMS_PACKAGE, "-k", kernel]):
        return Finding("kernel", Health.OK, f"DKMS build for {kernel}")
    return Finding("kernel", Health.FAIL, f"no DKMS build for {kernel}",
                   f"sudo dkms autoinstall -k {kernel}   (needs kernel-devel for this kernel)")


def check_boot_loading():
    if MODULES_LOAD_CONF.exists():
        return Finding("boot", Health.OK, "loads at boot")
    return Finding("boot", Health.WARN, "not loaded automatically at boot", "sudo ./install.sh" + FROM_PROJECT)


def check_permissions(hwmon):
    if not hwmon:
        return Finding("permissions", Health.INFO, "needs the driver")
    energy = SystemReadings._find_package_zone()
    if energy and not os.access(energy / "energy_uj", os.R_OK):
        return Finding("permissions", Health.WARN, "CPU package power hidden (energy counter is root-only)",
                       "sudo ./install.sh" + FROM_PROJECT + "   (and make sure you are in the wheel or sudo group)")
    if os.access(hwmon / "device" / "fan_mode", os.W_OK):
        return Finding("permissions", Health.OK, "fan controls and CPU power readable without sudo")
    if not UDEV_RULE.exists():
        return Finding("permissions", Health.WARN, "fan controls need sudo", "sudo ./install.sh" + FROM_PROJECT)
    return Finding("permissions", Health.WARN, "udev rule present but not applied",
                   "sudo udevadm trigger --action=add --subsystem-match=hwmon --attr-match=name=hp_zbook_fury"
                   "  (and make sure you are in the wheel or sudo group)")


def check_saved_fan_mode():
    if not SAVED_FAN_MODE.exists():
        return Finding("reboots", Health.WARN, "fan mode resets to power mode at every boot",
                       "sudo ./install.sh" + FROM_PROJECT)
    if not os.access(SAVED_FAN_MODE, os.W_OK):
        return Finding("reboots", Health.WARN, f"can't save the fan mode to {SAVED_FAN_MODE} without sudo",
                       "make sure you are in the wheel or sudo group")
    return Finding("reboots", Health.OK, f"fan mode kept across reboots ({read_text(SAVED_FAN_MODE)})")


def check_profiles():
    owners = [read_text(name) for name in Path("/sys/class/platform-profile").glob("*/name")]
    if DRIVER_NAME not in owners:
        return Finding("profiles", Health.FAIL, "fan profiles not registered", "load the driver first")
    active = run(["busctl", "--system", "get-property", "net.hadess.PowerProfiles",
                  "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles", "ActiveProfile"])
    if not active:
        return Finding("profiles", Health.WARN, "no power-profile service; desktop switch will not drive the fans",
                       "sudo systemctl enable --now tuned-ppd   (or power-profiles-daemon)")
    desktop = active.split('"')[1] if '"' in active else active
    platform = read_text(PLATFORM_PROFILE)
    expected = {v: k for k, v in DESKTOP_PROFILES.items()}.get(desktop)
    if expected and expected != platform:
        return Finding("profiles", Health.WARN, f"desktop says {desktop}, fans are on {platform}",
                       "switch the desktop power mode once")
    return Finding("profiles", Health.OK, f"desktop {desktop} → driver {platform}")


def check_fans(hwmon):
    if not hwmon:
        return Finding("fans", Health.INFO, "needs the driver")
    rpms = [int(read_text(hwmon / f"fan{i}_input") or 0) for i in range(1, FAN_COUNT + 1)]
    readings = " · ".join(str(rpm) for rpm in rpms) + " rpm"
    if any(rpm == 0 for rpm in rpms):
        return Finding("fans", Health.WARN, readings + " (a fan reports 0)",
                       "a stopped fan can be normal at idle; if it persists under load, check the hardware")
    return Finding("fans", Health.OK, readings)


def check_firmware_resets(kernel_log):
    if not kernel_log:
        return Finding("firmware", Health.INFO, "kernel log not readable (add yourself to wheel or adm)")
    resets = kernel_log.count(AFAN_RESTORE_LOG)
    if resets:
        return Finding("firmware", Health.INFO, f"firmware reset the fan mode {resets}× this boot; the driver restored it")
    return Finding("firmware", Health.OK, "no fan-mode resets this boot")


def check_update():
    release = latest_release()
    if release is None:
        return Finding("updates", Health.INFO, "couldn't check GitHub releases (offline or none published)")
    if not is_newer(release.version):
        return Finding("updates", Health.OK, f"{VERSION} is the latest")
    return Finding("updates", Health.WARN, f"{release.version} available, this is {VERSION}", "zfan update")


def diagnose():
    hwmon = find_driver_hwmon()
    kernel_log = kernel_log_this_boot()
    return [
        check_hardware(),
        check_driver(hwmon),
        check_kernel_build(),
        check_boot_loading(),
        check_permissions(hwmon),
        check_saved_fan_mode(),
        check_profiles(),
        check_fans(hwmon),
        check_firmware_resets(kernel_log),
        check_update(),
    ]


def print_doctor():
    findings = diagnose()
    print()
    print(MARGIN + paint("zfan doctor", TEXT, bold=True))
    print()
    for finding in findings:
        symbol, color = finding.health.value
        print(row(finding.label, paint(symbol, color, bold=True) + " " + paint(finding.detail, TEXT)))
        if finding.fix and finding.health is not Health.OK:
            print(row("", paint("  → " + finding.fix, MUTED)))
    problems = [f for f in findings if f.health in (Health.WARN, Health.FAIL)]
    print()
    if problems:
        print(MARGIN + paint(f"{len(problems)} to look at · fixes above", HOT if any(
            f.health is Health.FAIL for f in problems) else ACCENT))
    else:
        print(MARGIN + paint("all good", ACCENT))
    print()
    return 1 if any(f.health is Health.FAIL for f in findings) else 0


