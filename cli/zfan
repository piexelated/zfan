STATUS_SAMPLE_S = 0.5


def print_status(hardware, view=View.MAIN):
    width = min(shutil.get_terminal_size((MAX_WIDTH, 20)).columns, MAX_WIDTH)
    Snapshot(hardware)  # primes the rate meters (CPU power, throttling)
    time.sleep(STATUS_SAMPLE_S)
    print("\n".join(render_panel(Snapshot(hardware), width, view)))


def confirm(message):
    print(MARGIN + paint("✓ ", ACCENT) + message)


def print_error(error):
    print(MARGIN + paint("✗ ", HOT) + error.message, file=sys.stderr)
    if error.hint:
        print(MARGIN + "  " + paint(error.hint, MUTED), file=sys.stderr)


def help_text():
    def entry(command, description):
        return MARGIN + paint(command.ljust(30), TEXT) + paint(description, MUTED)

    return "\n".join([
        "",
        MARGIN + paint("zfan", TEXT, bold=True) + " " + note(VERSION)
        + paint("  fan control for the HP ZBook Fury G1i", MUTED),
        "",
        entry("zfan", "interactive dashboard"),
        entry("zfan status", "one-shot status"),
        entry("zfan details", "one-shot details: every power limit, clocks, HP and EC sensors, battery"),
        entry("zfan doctor", "check the setup and suggest fixes"),
        entry("zfan fans <mode>", "follow (the desktop power profile) · quiet · auto · boost"),
        entry("zfan update", "install the latest release (asks for your password)"),
        entry("zfan uninstall", "remove the driver and zfan (asks to confirm, then for your password)"),
        entry("zfan --version", "print the version"),
        "",
    ])


def interactive():
    return sys.stdin.isatty() and sys.stdout.isatty()


def choice(argv, options, what):
    value = argv[2] if len(argv) > 2 else None
    if value not in options:
        raise FanError(f"{what}: choose one of {', '.join(options)}", "see zfan --help")
    return value


def run_command(hardware, argv):
    command = argv[1] if len(argv) > 1 else ("dashboard" if interactive() else "status")
    if command == "dashboard":
        run_dashboard(hardware)
    elif command == "status":
        print_status(hardware)
    elif command == "details":
        print_status(hardware, View.DETAILS)
    elif command == "fans":
        mode = choice(argv, FAN_MODES, "fans")
        hardware.set_fan_mode(mode)
        confirm(f"fans {mode}")
    else:
        raise FanError(f"unknown command '{command}'", "see zfan --help")


def run_without_hardware(command):
    try:
        command()
    except FanError as error:
        print_error(error)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


def main(argv):
    if argv[1:2] in (["-h"], ["--help"], ["help"]):
        print(help_text())
        return 0
    if argv[1:2] in (["-V"], ["--version"], ["version"]):
        print(f"zfan {VERSION}")
        return 0
    if argv[1:2] == ["doctor"]:
        return print_doctor()
    if argv[1:2] == ["update"]:
        # Works without the driver, so a broken install can update itself.
        return run_without_hardware(update)
    if argv[1:2] == ["uninstall"]:
        # Works without the driver, so a broken install can still be removed.
        return run_without_hardware(uninstall)
    try:
        run_command(FanHardware(), argv)
    except FanError as error:
        print_error(error)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
