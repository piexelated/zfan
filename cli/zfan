class FanError(Exception):
    """A user-facing failure, optionally with a hint on how to fix it."""

    def __init__(self, message, hint=None):
        super().__init__(message)
        self.message = message
        self.hint = hint


# ─── styling ────────────────────────────────────────────────────────────────

def blend(start, end, fraction):
    return tuple(round(a + (b - a) * fraction) for a, b in zip(start, end))


def level_gradient(fraction):
    """COOL at 0, ACCENT at 0.5, HOT at 1."""
    if fraction < 0.5:
        return blend(COOL, ACCENT, fraction * 2)
    return blend(ACCENT, HOT, (fraction - 0.5) * 2)


def paint(text, rgb, bold=False):
    if not COLOR:
        return text
    weight = "1;" if bold else ""
    return f"\x1b[{weight}38;2;{rgb[0]};{rgb[1]};{rgb[2]}m{text}\x1b[0m"


def visible_len(text):
    length, in_escape = 0, False
    for ch in text:
        if ch == "\x1b":
            in_escape = True
        elif in_escape and ch == "m":
            in_escape = False
        elif not in_escape:
            length += 1
    return length


def spread(left, right, width):
    return left + " " * max(1, width - visible_len(left) - visible_len(right)) + right


def row(label, content=""):
    return MARGIN + paint(label.ljust(LABEL_WIDTH), MUTED) + content



# ─── system files ───────────────────────────────────────────────────────────

def run(command, timeout=10):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout.strip()


def read_text(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def celsius_from(path):
    millidegrees = read_text(path)
    return int(millidegrees) // 1000 if millidegrees.lstrip("-").isdigit() else None



