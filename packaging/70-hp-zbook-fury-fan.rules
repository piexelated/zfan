# Let members of wheel switch full fan speed (pwm1_enable) and the fan mode without sudo.
ACTION=="add", SUBSYSTEM=="hwmon", ATTR{name}=="hp_zbook_fury", RUN+="/usr/bin/chgrp wheel /sys%p/pwm1_enable /sys%p/device/fan_mode", RUN+="/usr/bin/chmod g+w /sys%p/pwm1_enable /sys%p/device/fan_mode"
# Let members of wheel read CPU package energy (RAPL) so zfan can show package power.
# Root-only by default as a side-channel mitigation; wheel members can sudo anyway.
ACTION=="add", SUBSYSTEM=="powercap", KERNEL=="intel-rapl:0", RUN+="/usr/bin/chgrp wheel /sys%p/energy_uj", RUN+="/usr/bin/chmod g+r /sys%p/energy_uj"
